# TaskReminder v3.0.0 Docker Compose 环境变量模板
# 复制为 deploy/.env 并修改以下密钥后执行: docker compose -f deploy/docker-compose.yml up -d

SERVER_PORT=8080

MYSQL_ROOT_PASSWORD=replace_with_strong_root_password
MYSQL_DATABASE=task_reminder
MYSQL_USER=task_user
MYSQL_PASSWORD=replace_with_strong_db_password

# 至少 32 字节随机字符串，可用 `openssl rand -hex 32` 生成
JWT_SECRET=replace_with_at_least_32_bytes_random_secret_string

# 首次启动自动创建管理员；留空 INIT_ADMIN_PASSWORD 将自动生成 16 位随机密码并在首次日志打印一次
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=

ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=30
RUST_LOG=info,task_reminder_server=info
